# =====================================================================
#  Cloudflare Pages 보안 헤더 — 익명성·보안 강화(앱 전역 적용)
#  이 파일은 빌드 시 dist/ 루트로 복사되어 모든 응답에 헤더를 추가한다.
#
#  ⚠️ CSP script-src 의 'sha256-...' 두 개는 index.html 인라인 스크립트의 해시.
#     인라인 스크립트를 수정하면 해시가 달라져 화면이 깨진다 → 아래 명령으로
#     재계산해 두 값을 모두 교체할 것.
#     두 개인 이유: Pages Git 빌드는 LF, 윈도우 로컬 npm run deploy 는 CRLF 로
#     서빙되어 같은 스크립트라도 바이트가 달라 해시가 다르다(줄바꿈 함정).
#       node -e "const f=require('fs'),c=require('crypto');const m=f.readFileSync('index.html','utf8').match(/<script>([\s\S]*?)<\/script>/);const lf=m[1].replace(/\r\n/g,'\n');for(const[n,s]of[['LF  ',lf],['CRLF',lf.replace(/\n/g,'\r\n')]])console.log(n,'sha256-'+c.createHash('sha256').update(s,'utf8').digest('base64'))"
# =====================================================================

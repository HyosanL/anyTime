# =====================================================================
#  Cloudflare Pages 보안 헤더 — 익명성·보안 강화(앱 전역 적용)
#  이 파일은 빌드 시 dist/ 루트로 복사되어 모든 응답에 헤더를 추가한다.
#
#  ⚠️ CSP script-src 의 'sha256-...' 두 개는 index.html 인라인 스크립트의 해시.
#     인라인 스크립트를 수정하면 해시가 달라져 화면이 깨진다 → 아래 명령으로
#     재계산해 두 값을 모두 교체할 것.
#     두 개인 이유: Pages Git 빌드는 LF, 윈도우 로컬 npm run deploy 는 CRLF 로
#     서빙되어 같은 스크립트라도 바이트가 달라 해시가 다르다(줄바꿈 함정).
#       node -e "const f=require('fs'),c=require('crypto');const m=f.readFileSync('index.html','utf8').match(/<script>([\s\S]*?)<\/script>/);const lf=m[1].replace(/\r\n/g,'\n');for(const[n,s]of[['LF  ',lf],['CRLF',lf.replace(/\n/g,'\r\n')]])console.log(n,'sha256-'+c.createHash('sha256').update(s,'utf8').digest('base64'))"
# =====================================================================
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-7OcdZiX5A5ldfjEKTIOJqSCT+WCNSY9uTT9o9CK7t5M=' 'sha256-WFsFz9RRrzyB0lrGzsurnPkRdq4H+NhmCgyUxuj2gDM='; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://asia-northeast3-anytime-rokafa.cloudfunctions.net; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# 해시가 박힌 산출물(assets/index-a1b2c3.js …)은 내용이 바뀌면 파일명이 바뀐다 → 영구 캐시해도 안전하다.
# 이 헤더가 없으면 브라우저가 방문 때마다 '안 바뀌었나' 재검증(304)을 왕복한다 — 특히 서비스워커
# 캐시가 없는 방문자(카톡 공유 링크로 처음 들어온 사람)가 그 지연을 그대로 맞는다.
#
# ⚠️ immutable 은 '틀린 응답'도 1년 못 박는다. 이 규칙은 파일이 아니라 경로에 걸리므로,
#    없는 청크에 SPA 폴백(index.html 200)이 나가면 그 HTML 이 JS 자리에 1년 눌러앉는다
#    (2026-07-13 장애). 그래서 _redirects 가 /assets/* 미스를 진짜 404 로 떨어뜨린다.
#    이 헤더를 손볼 때 _redirects 의 /assets/* 규칙을 함께 보라 — 둘은 한 쌍이다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 서비스워커 스크립트는 캐시하지 않는다. 기본값(Cloudflare 존)은 4시간인데, iOS PWA 는
# 그 Cache-Control 을 그대로 따라 registration.update() 가 최대 4시간 옛 sw.js 를 받는다
# → "새 버전이 나왔어요" 배너가 안 뜨고 갱신이 멈춘다. no-cache = 매번 재검증(변경 없으면 304).
# push-sw.js 는 ?v=N 쿼리로 임포트되지만 _headers 는 경로만 보므로 이 규칙이 그대로 적용된다.
/sw.js
  Cache-Control: no-cache

/push-sw.js
  Cache-Control: no-cache
